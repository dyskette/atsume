[Unit]
Description=atsume — manga downloader
After=atsume-pod.service
BindsTo=atsume-pod.service

[Container]
ContainerName=atsume
Pod=atsume.pod
Image=ghcr.io/dyskette/atsume:latest
AutoUpdate=registry

Volume=atsume-data:/data:Z
# Point this at the same directory your library server scans.
Volume=%h/media/manga:/library:z

Environment=ATSUME_LOG_LEVEL=info
# Pin to a commit SHA in production so an upstream change cannot reach you
# unreviewed.
Environment=ATSUME_MODULES_REF=master
Environment=ATSUME_WORKERS=3
Environment=ATSUME_HOST_RPS=1

[Service]
Restart=always

[Install]
WantedBy=default.target
