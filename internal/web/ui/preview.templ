package ui

import (
	"fmt"

	"github.com/dyskette/atsume/internal/scraper"
)

// PreviewView is a look at a series that is not in the library.
type PreviewView struct {
	Module    string
	SeriesURL string
	// SiteURL is the same link resolved against the site, which is what
	// "open on site" has to use: a module stores links with the host
	// stripped, so the raw one resolves against atsume instead.
	SiteURL string
	Info      *scraper.MangaInfo
	// Chapters is how many the site lists, which is the number that tells a
	// reader whether following this will eventually mean a large backlog.
	Chapters int
}

// CoverURL routes the cover through atsume, because the image hosts these
// sites use refuse a request whose Referer is not their own.
func (v PreviewView) CoverURL() string {
	return fmt.Sprintf("/modules/%s/preview-cover?url=%s",
		v.Module, escapeQueryValue(v.Info.CoverLink))
}

// Preview shows a series before it is followed.
templ Preview(v PreviewView) {
	@Layout(v.Info.Title) {
		<div class="head">
			<h1>{ v.Info.Title }</h1>
			<a href={ templ.SafeURL("/modules/" + v.Module) }>Back to { v.Module }</a>
		</div>
		<div class="series-head">
			if v.Info.CoverLink != "" {
				<img class="cover" src={ v.CoverURL() } alt="" loading="lazy"/>
			}
			<div class="series-meta">
				<p class="muted">
					{ v.Module }
					if v.Info.Status != "" {
						{ " · " }{ v.Info.Status }
					}
					if v.Info.Authors != "" {
						{ " · " }{ v.Info.Authors }
					}
					{ " · " }
					<a href={ templ.SafeURL(v.SiteURL) } target="_blank" rel="noreferrer noopener">Open on site</a>
				</p>
				<p class="have">
					if v.Chapters > 0 {
						{ fmt.Sprintf("%d chapters listed", v.Chapters) }
					} else {
						No chapters listed
					}
				</p>
				@FollowPrompt(v)
				if v.Info.Genres != "" {
					<p class="muted">{ v.Info.Genres }</p>
				}
			</div>
		</div>
		if v.Info.Summary != "" {
			<details class="description" open>
				<summary>Description</summary>
				<p class="summary">{ v.Info.Summary }</p>
			</details>
		}
	}
}

// FollowPrompt is the offer to follow, with the sentence that explains what
// following will and will not do.
//
// The sentence is inside the swap because it describes the state: leaving it
// outside meant the page still read "Not in your library" under a series that
// had just been added to it.
templ FollowPrompt(v PreviewView) {
	<div id="follow-state">
		<p class="muted">
			Not in your library. Following downloads chapters published from
			that point on; the { fmt.Sprintf("%d", v.Chapters) } already listed
			stay a separate, deliberate download.
		</p>
		<form class="actions" hx-post="/series" hx-target="#follow-state" hx-swap="outerHTML">
			<input type="hidden" name="module" value={ v.Module }/>
			<input type="hidden" name="url" value={ v.SeriesURL }/>
			<input type="hidden" name="name" value={ v.Info.Title }/>
			<input type="hidden" name="context" value="page"/>
			<button type="submit" class="primary">Follow this series</button>
		</form>
	</div>
}

// Followed replaces the offer once the series is in the library, and says what
// has changed rather than repeating what the button was called.
templ FollowedPrompt(id int64) {
	<div id="follow-state">
		<p class="muted">
			In your library. New chapters download as they are published; the
			ones already listed are a separate, deliberate download.
		</p>
		<div class="actions">
			<span class="badge done">following</span>
			<a class="cta" href={ templ.SafeURL(fmt.Sprintf("/series/%d", id)) }>Open in library</a>
		</div>
	</div>
}
