package ui

import "fmt"

// SeriesPage answers, in order: what is this, what do I have, what can I do,
// and then the chapters. The description comes last, behind a disclosure — it
// is the largest thing on the page and the least actionable, and letting it
// lead pushed everything that mattered below the fold.
templ SeriesPage(v SeriesView) {
	@Layout(v.Series.Title) {
		<div class="series-head">
			if v.Series.CoverURL != "" {
				<img
					class="cover"
					src={ fmt.Sprintf("/series/%d/cover", v.Series.ID) }
					alt={ "Cover of " + v.Series.Title }
					loading="lazy"
				/>
			}
			<div class="series-meta">
				<h1>{ v.Series.Title }</h1>
				<p class="muted">
					{ v.Series.ModuleName }
					if v.Series.Status != "" {
						{ " · " }{ v.Series.Status }
					}
					if v.Series.Authors != "" {
						{ " · " }{ v.Series.Authors }
					}
					{ " · " }
					<a href={ templ.SafeURL(v.Series.URL) } target="_blank" rel="noreferrer noopener">Open on site</a>
					{ " · " }
					<a href={ templ.SafeURL(v.SettingsURL()) }>Site settings</a>
				</p>
				if v.HaveLine() != "" {
					<p class="have">{ v.HaveLine() }</p>
				}
				<div class="actions">
					if v.Counts.Waiting() > 0 {
						<form hx-post={ fmt.Sprintf("/series/%d/download", v.Series.ID) } hx-swap="none">
							<button type="submit" class="primary">
								{ "Download " + Count(v.Counts.Waiting(), "chapter", "chapters") }
							</button>
						</form>
					}
					<form hx-post={ fmt.Sprintf("/series/%d/refresh", v.Series.ID) } hx-swap="none">
						<button type="submit">Check for new chapters</button>
					</form>
				</div>
				@FollowControl(v)
				<p class="muted dest">
					Chapters are written to <code>{ v.Destination }</code>
				</p>
				<div id="remove">
					@RemoveControl(v)
				</div>
			</div>
		</div>

		<div class="head">
			<h2>
				if v.Counts.Total > 0 {
					{ fmt.Sprintf("Chapters (%d)", v.Counts.Total) }
				} else {
					Chapters
				}
			</h2>
		</div>
		if v.Counts.Total == 0 {
			@chaptersEmpty(v)
		}
		<ul class="rows chapters">
			for _, c := range v.Chapters {
				@ChapterRowState(c, v.Missing[c.ID])
			}
		</ul>

		if v.Series.Summary != "" {
			<details class="description">
				<summary>Description</summary>
				<p class="summary">{ v.Series.Summary }</p>
				if v.Series.Genres != "" {
					<p class="muted">{ v.Series.Genres }</p>
				}
			</details>
		}
	}
}

// chaptersEmpty distinguishes "never checked" from "checked and found none",
// because the two call for completely different actions.
templ chaptersEmpty(v SeriesView) {
	{{ headline, detail := v.ChaptersEmptyReason() }}
	<div class="empty">
		<strong>{ headline }</strong>
		<p>{ detail }</p>
		if v.SiteNeedsLogin && !v.SiteHasCredentials {
			<p><a class="cta" href={ templ.SafeURL(v.SettingsURL()) }>Add an account for { v.Series.ModuleName }</a></p>
		}
	</div>
}

// FollowControl states the standing arrangement and offers the one change to
// it. It is deliberately not a button among the actions: following is a state,
// not something you do, and mixing the two made the label read as a progress
// report.
templ FollowControl(v SeriesView) {
	<div
		id={ fmt.Sprintf("follow-%d", v.Series.ID) }
		class={ "follow", templ.KV("on", v.Series.Subscribed) }
	>
		<span>{ v.FollowLine() }</span>
		<form hx-post={ fmt.Sprintf("/series/%d/subscribe", v.Series.ID) } hx-swap="outerHTML" hx-target={ fmt.Sprintf("#follow-%d", v.Series.ID) }>
			if v.Series.Subscribed {
				<input type="hidden" name="on" value="0"/>
				<button type="submit">Stop following</button>
			} else {
				<input type="hidden" name="on" value="1"/>
				<button type="submit" class="primary">Follow</button>
			}
		</form>
	</div>
}

// RemoveControl offers to forget the series. It is deliberately quiet and
// last: it is the one thing on this page that cannot be undone.
templ RemoveControl(v SeriesView) {
	<p class="muted remove">
		<button
			type="button"
			class="link"
			hx-get={ fmt.Sprintf("/series/%d/remove", v.Series.ID) }
			hx-target="#remove"
			hx-swap="innerHTML"
		>Remove from atsume</button>
	</p>
}

// ConfirmRemove states exactly what removing does before it is done.
//
// The question a reader actually has is whether their files are about to go,
// and a browser confirmation box cannot answer it. So the page does, in the
// place the decision is made.
templ ConfirmRemove(v SeriesView) {
	<div class="confirm">
		<p>
			<strong>Remove { v.Series.Title } from atsume?</strong>
		</p>
		<p class="muted">
			atsume forgets the series and stops checking it.
			if v.Counts.Done > 0 {
				The { Count(v.Counts.Done, "chapter", "chapters") } already
				downloaded to <code>{ v.Destination }</code> { areOrIs(v.Counts.Done) }
				left alone — those files belong to whatever reads that folder,
				and nothing here deletes them.
			} else {
				No files have been written for it, so there is nothing on disk
				either way.
			}
		</p>
		<div class="actions">
			<form hx-post={ fmt.Sprintf("/series/%d/remove", v.Series.ID) } hx-swap="none">
				<button type="submit" class="danger">Remove, keep the files</button>
			</form>
			<button
				type="button"
				hx-get={ fmt.Sprintf("/series/%d/remove?cancel=1", v.Series.ID) }
				hx-target="#remove"
				hx-swap="innerHTML"
			>Cancel</button>
		</div>
	</div>
}
