package ui

import "fmt"

// SeriesPage is one series, in the library or not. Being in the library is a
// state of the series, not a different page, so the page is the same however
// it was reached and only its controls follow the state: untracked, saved
// (something downloaded, not followed) or followed.
templ SeriesPage(v SeriesView) {
	@Layout(v.Series.Title) {
		<div class="series-head">
			<div class="cover-wrap">
				if v.CoverURL() != "" {
					<img class="cover" src={ v.CoverURL() } alt={ "Cover of " + v.Series.Title } loading="lazy"/>
				} else {
					<div class="cover blank"></div>
				}
				if v.Tracked() {
					<span class="in-library">✓ In library</span>
				}
			</div>
			<div class="series-meta">
				<p class="meta">
					<span class="site">{ v.Series.ModuleName }</span>
					if v.Series.Status != "" {
						<span class="state">{ v.Series.Status }</span>
					}
					if v.Series.Authors != "" {
						<span>{ v.Series.Authors }</span>
					}
					<a href={ templ.SafeURL(v.SiteURL) } target="_blank" rel="noreferrer noopener">Open on { v.Series.ModuleName } ↗</a>
				</p>
				<h1>{ v.Series.Title }</h1>
				if len(v.Genres()) > 0 {
					<ul class="chips">
						for _, g := range v.Genres() {
							<li>{ g }</li>
						}
					</ul>
				}
				if v.Series.Summary != "" {
					<p class="summary clamp">{ v.Series.Summary }</p>
					<button type="button" class="link more" onclick="this.previousElementSibling.classList.toggle('clamp'); this.textContent = this.textContent === 'More' ? 'Less' : 'More'">More</button>
				}
				@SeriesActions(v)
			</div>
		</div>
		@chapterList(v)
	}
}

// SeriesActions is the part of the header that changes with the series'
// state: its two real actions, the ⋯ menu for the rarely used ones, and the
// line saying where the series stands. Following, unfollowing and queueing
// swap it in place.
templ SeriesActions(v SeriesView) {
	<div id="series-actions">
		<div class="actions">
			@followButton(v)
			if v.ToDownload() > 0 {
				@downloadAllButton(v)
			}
			@seriesMenu(v)
		</div>
		if v.Tracked() {
			<p class={ "status", templ.KV("on", v.Series.Subscribed) }>
				<span class="dot"></span>
				<span>{ v.StatusLine() }</span>
				if v.Series.Subscribed {
					{ " · " }
					<button type="button" class="link" hx-post={ fmt.Sprintf("/series/%d/refresh", v.Series.ID) } hx-swap="none">Check now</button>
				}
			</p>
			<div id="remove"></div>
		} else {
			<p class="muted hint">Follow to get new chapters automatically, or download any chapter to keep it.</p>
		}
	</div>
}

// followButton is Follow until the series is followed, then a Following
// toggle that unfollows. Unfollowing keeps the series in the library.
templ followButton(v SeriesView) {
	if !v.Tracked() {
		<form hx-post={ "/modules/" + v.Module + "/series/follow" }>
			<input type="hidden" name="url" value={ v.SeriesURL }/>
			<button type="submit" class="primary">+ Follow</button>
		</form>
	} else {
		<form hx-post={ fmt.Sprintf("/series/%d/subscribe", v.Series.ID) } hx-target="#series-actions" hx-swap="outerHTML">
			if v.Series.Subscribed {
				<input type="hidden" name="on" value="0"/>
				<button type="submit" class="following" title="Stop following; the series stays in your library">✓ Following</button>
			} else {
				<input type="hidden" name="on" value="1"/>
				<button type="submit" class="primary">+ Follow</button>
			}
		</form>
	}
}

// downloadAllButton queues every chapter not downloaded. A series not in the
// library is saved first, which reloads the page as a library series.
templ downloadAllButton(v SeriesView) {
	if !v.Tracked() {
		<form hx-post={ "/modules/" + v.Module + "/series/download" }>
			<input type="hidden" name="url" value={ v.SeriesURL }/>
			<button type="submit">↓ { v.DownloadLabel() }</button>
		</form>
	} else {
		<form hx-post={ fmt.Sprintf("/series/%d/download", v.Series.ID) } hx-target="#series-actions" hx-swap="outerHTML">
			<button type="submit">↓ { v.DownloadLabel() }</button>
		</form>
	}
}

// seriesMenu holds what is rarely needed, so the header keeps two actions.
templ seriesMenu(v SeriesView) {
	<details class="menu">
		<summary aria-label="More actions">⋯</summary>
		<div class="menu-items">
			<a href={ templ.SafeURL(v.SettingsURL()) }>Site settings</a>
			<p class="dest">Saved to <code>{ v.Destination }</code></p>
			if v.Tracked() {
				<button type="button" hx-post={ fmt.Sprintf("/series/%d/refresh", v.Series.ID) } hx-swap="none">Check now</button>
				<button type="button" class="danger-text" hx-get={ fmt.Sprintf("/series/%d/remove", v.Series.ID) } hx-target="#remove" hx-swap="innerHTML">Remove from library</button>
			}
		</div>
	</details>
}

// ConfirmRemove states exactly what removing does before it is done.
//
// The question a reader actually has is whether their files are about to go,
// and a browser confirmation box cannot answer it. So the page does, in the
// place the decision is made.
templ ConfirmRemove(v SeriesView) {
	<div class="confirm">
		<p>
			<strong>Remove { v.Series.Title } from your library?</strong>
		</p>
		<p class="muted">
			atsume forgets the series and stops checking it.
			if v.Counts.Done > 0 {
				The { Count(v.Counts.Done, "chapter", "chapters") } already
				downloaded to <code>{ v.Destination }</code> { areOrIs(v.Counts.Done) }
				left alone — those files belong to whatever reads that folder,
				and nothing here deletes them.
			} else {
				No files have been written for it, so there is nothing on disk
				either way.
			}
		</p>
		<div class="actions">
			<form hx-post={ fmt.Sprintf("/series/%d/remove", v.Series.ID) } hx-swap="none">
				<button type="submit" class="danger">Remove, keep the files</button>
			</form>
			<button
				type="button"
				hx-get={ fmt.Sprintf("/series/%d/remove?cancel=1", v.Series.ID) }
				hx-target="#remove"
				hx-swap="innerHTML"
			>Cancel</button>
		</div>
	</div>
}
