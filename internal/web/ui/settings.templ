package ui

import (
	"fmt"

	"github.com/dyskette/atsume/internal/app"
	"github.com/dyskette/atsume/internal/scraper"
)

// ModuleSettingsPage is the settings page as a whole document.
templ ModuleSettingsPage(s *app.ModuleSettings) {
	@Layout(s.Module) {
		@ModuleSettings(s, false)
	}
}

// ModuleSettings is the settings content on its own.
//
// Saving swaps this in, so it must not carry the page chrome with it: it used
// to render the whole document into a target inside the page, which is why a
// save produced a second header and a second footer.
templ ModuleSettings(s *app.ModuleSettings, saved bool) {
	<div id="settings">
		<div class="head">
			<h1>{ s.Module }</h1>
			<a href={ templ.SafeURL("/modules/" + s.Module) }>Browse</a>
		</div>
		if saved {
			<p class="saved">Saved.</p>
		}
		<form
			hx-post={ fmt.Sprintf("/modules/%s/settings", s.Module) }
			hx-swap="outerHTML"
			hx-target="#settings"
		>
			<h2>Options</h2>
			<p class="muted">
				A change here takes effect on the next check, not retrospectively.
				Re-check below once you have saved.
			</p>
			if len(s.Options) == 0 {
				<p class="muted">This module declares no options.</p>
			}
			<ul class="rows">
				for _, o := range s.Options {
					<li>
						<span class="title">{ optionLabel(o) }</span>
						@optionField(o, s.Values[o.Name])
					</li>
				}
			</ul>

			if len(s.Mirrors) > 1 {
				<h2>Address</h2>
				<p class="muted">
					{ Count(len(s.Mirrors), "address is", "addresses are") } declared for
					this site. They serve the same catalogue; pick another when one
					stops answering.
				</p>
				<ul class="rows">
					<li>
						<span class="title">In use</span>
						<select name={ app.MirrorOption }>
							for _, m := range s.Mirrors {
								if m == s.Mirror {
									<option value={ m } selected>{ m }</option>
								} else {
									<option value={ m }>{ m }</option>
								}
							}
						</select>
					</li>
				</ul>
			}

			<h2>Account</h2>
			if !s.SupportsLogin {
				<p class="muted">This module does not take a login.</p>
			} else if !s.SecretsEnabled {
				<p class="muted">
					Set <code>ATSUME_SECRET_KEY</code> to store a login. Without it a
					password would be kept in the clear, which is refused.
				</p>
			} else {
				<ul class="rows">
					<li>
						<span class="title">Username</span>
						<input type="text" name="__username" value={ s.Username } autocomplete="off"/>
					</li>
					<li>
						<span class="title">Password</span>
						<input
							type="password"
							name="__password"
							autocomplete="new-password"
							placeholder={ passwordPlaceholder(s) }
						/>
					</li>
				</ul>
				<p class="muted">
					Test checks the fields as typed. Leave the password blank to keep
					the stored one; clear both fields to remove the login.
				</p>
				<div class="actions">
					<!-- Sends the fields as typed, so a password is tested before
					     it is saved rather than after. -->
					<button
						type="button"
						hx-post={ fmt.Sprintf("/modules/%s/test-login", s.Module) }
						hx-include="[name='__username'], [name='__password']"
						hx-target="#login-result"
						hx-swap="innerHTML"
					>Test login</button>
					<span id="login-result"></span>
				</div>
			}

			<div class="actions"><button type="submit" class="primary">Save</button></div>
		</form>

		<h2>{ fmt.Sprintf("Series from this site (%d)", len(s.Series)) }</h2>
		if len(s.Series) == 0 {
			<p class="muted">Nothing from this site is in your library yet.</p>
		} else {
			<p class="muted">
				A setting only applies from the next check onwards, so re-check after
				saving to see the difference.
			</p>
			<form
				class="actions"
				hx-post={ fmt.Sprintf("/modules/%s/recheck", s.Module) }
				hx-target="#recheck-result"
				hx-swap="innerHTML"
			>
				<button type="submit" class="primary">
					{ fmt.Sprintf("Re-check %d series", len(s.Series)) }
				</button>
				<span id="recheck-result"></span>
			</form>
			<ul class="rows">
				for _, item := range s.Series {
					<li>
						<a class="title" href={ templ.SafeURL(fmt.Sprintf("/series/%d", item.ID)) }>{ item.Title }</a>
					</li>
				}
			</ul>
		}
	</div>
}

// LoginResult reports what a test sign-in did.
templ LoginResult(ok bool, detail string) {
	if ok {
		<span class="badge done">{ detail }</span>
	} else {
		<span class="badge failed">{ detail }</span>
	}
}

// optionField renders the control a module asked for.
templ optionField(o scraper.Option, value string) {
	switch o.Kind {
		case scraper.OptionCheckBox:
			<input type="checkbox" name={ o.Name } value="1" checked?={ value == "1" }/>
		case scraper.OptionSpinEdit:
			<input type="number" name={ o.Name } value={ value }/>
		case scraper.OptionComboBox:
			<select name={ o.Name }>
				for i, item := range o.Items {
					<option value={ fmt.Sprint(i) } selected?={ value == fmt.Sprint(i) }>{ item }</option>
				}
			</select>
		default:
			<input type="text" name={ o.Name } value={ value }/>
	}
}
