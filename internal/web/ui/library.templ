package ui

import (
	"fmt"

	"github.com/dyskette/atsume/internal/store"
)

// Library is the home page: what is being followed and whether it is current.
templ Library(v LibraryView) {
	@Layout("Library") {
		<div class="head">
			<h1>Library</h1>
			if len(v.Rows) > 0 {
				<form hx-post="/check" hx-swap="none">
					<button type="submit">Check all now</button>
				</form>
			}
		</div>
		if len(v.Rows) == 0 {
			<div class="empty">
				<strong>Nothing here yet</strong>
				<p>
					atsume watches manga sites and writes finished chapters to
					<code>{ v.Destination }</code>, where Komga — or whatever reads that
					folder — picks them up.
				</p>
				<p>
					Pick a site, find a title, and follow it. New chapters are downloaded
					automatically from then on. Chapters already published are not:
					fetching a backlog stays your decision.
				</p>
				<p><a class="cta" href="/modules">Browse sites</a></p>
			</div>
		} else if n := v.NeedsAttention(); n > 0 {
			<p class="attention">{ fmt.Sprintf("%d series need attention.", n) }</p>
		}
		<ul class="rows library">
			for _, row := range v.Rows {
				@LibraryItem(row)
			}
		</ul>
	}
}

// LibraryItem is one series: cover, what it is, and whether it is current.
templ LibraryItem(r LibraryRow) {
	{{ label, kind := r.State() }}
	<li>
		<a class="thumb" href={ templ.SafeURL(fmt.Sprintf("/series/%d", r.Series.ID)) }>
			if r.Series.CoverURL != "" {
				<img
					src={ fmt.Sprintf("/series/%d/cover", r.Series.ID) }
					alt=""
					loading="lazy"
				/>
			}
		</a>
		<div class="grow">
			<a class="title" href={ templ.SafeURL(fmt.Sprintf("/series/%d", r.Series.ID)) }>{ r.Series.Title }</a>
			<div class="muted">{ r.Detail() }</div>
		</div>
		<span class={ "badge", kind }>{ label }</span>
	</li>
}

// ChapterRow is swapped in place over SSE as a download progresses. The id is
// what the stream targets, so it must stay stable across swaps.
templ ChapterRow(c store.Chapter) {
	<li
		id={ fmt.Sprintf("chapter-%d", c.ID) }
		class={ "chapter", c.State }
		sse-swap={ fmt.Sprintf("chapter-%d", c.ID) }
		hx-swap="outerHTML"
	>
		<span class="title">{ c.Name }</span>
		<span class={ "badge", c.State }>{ stateLabel(c) }</span>
		if c.Error != "" {
			<span class="error" title={ c.Error }>{ truncate(c.Error, 80) }</span>
		}
		if c.State == store.ChapterPending || c.State == store.ChapterFailed {
			<form hx-post={ fmt.Sprintf("/chapters/%d/download", c.ID) } hx-swap="outerHTML" hx-target="closest li">
				<button type="submit">Download</button>
			</form>
		}
	</li>
}

// ChapterProgressRow is the same row rendered mid-download, showing page
// progress. It keeps the id and sse-swap target so later events land on it.
templ ChapterProgressRow(c store.Chapter, done int, total int) {
	<li
		id={ fmt.Sprintf("chapter-%d", c.ID) }
		class="chapter downloading"
		sse-swap={ fmt.Sprintf("chapter-%d", c.ID) }
		hx-swap="outerHTML"
	>
		<span class="title">{ c.Name }</span>
		<span class="badge downloading">{ Progress(done, total) }</span>
	</li>
}

