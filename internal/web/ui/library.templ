package ui

import "fmt"

// Library is the home page: what is being followed and whether it is current.
templ Library(v LibraryView) {
	@Layout("Library") {
		<div class="head">
			<h1>Library</h1>
			if len(v.Rows) > 0 {
				<form hx-post="/check" hx-swap="none">
					<button type="submit">Check all now</button>
				</form>
			}
		</div>
		if len(v.Rows) == 0 {
			<div class="empty">
				<strong>Nothing here yet</strong>
				<p>
					atsume watches manga sites and writes finished chapters to
					<code>{ v.Destination }</code>, where Komga — or whatever reads that
					folder — picks them up.
				</p>
				<p>
					Pick a site, find a title, and follow it. New chapters are downloaded
					automatically from then on. Chapters already published are not:
					fetching a backlog stays your decision.
				</p>
				<p><a class="cta" href="/modules">Browse sites</a></p>
			</div>
		}
		if series, chapters := v.Waiting(); series > 0 {
			<!-- The batch form sits outside the lists so rows in any section
			     can join it by id; a form cannot wrap list items spread over
			     several lists. -->
			<form
				id="download-many"
				class="batch"
				hx-post="/download"
				hx-target="#download-result"
				hx-swap="innerHTML"
			>
				<button type="submit">Download selected</button>
				<span class="muted">
					{ Count(chapters, "chapter is", "chapters are") } waiting across
					{ Count(series, "series", "series") }.
				</span>
				<span id="download-result"></span>
			</form>
		}
		if stalled, why := v.Stalled(); stalled {
			<p class="attention">
				<strong>Checking has stopped.</strong>
				{ " " + why }
			</p>
		}
		for _, section := range v.Sections() {
			<div class="section-head">
				<h2>{ section.Title }</h2>
				<span class="count">{ Count(len(section.Rows), "series", "series") }</span>
			</div>
			if section.Blurb != "" {
				<p class="muted">{ section.Blurb }</p>
			}
			<ul class="rows library">
				for _, row := range section.Rows {
					@LibraryItem(row)
				}
			</ul>
		}
	}
}

// LibraryItem is one series: cover, what it is, and whether it is current.
templ LibraryItem(r LibraryRow) {
	{{ label, kind := r.State() }}
	<li>
		if r.Actionable() {
			<input
				class="pick"
				type="checkbox"
				name="sel"
				value={ fmt.Sprintf("%d", r.Series.ID) }
				form="download-many"
				aria-label={ "Select " + r.Series.Title }
			/>
		} else {
			<span class="pick"></span>
		}
		<a class="thumb" href={ templ.SafeURL(fmt.Sprintf("/series/%d", r.Series.ID)) }>
			if r.Series.CoverURL != "" {
				<img
					src={ fmt.Sprintf("/series/%d/cover", r.Series.ID) }
					alt=""
					loading="lazy"
				/>
			}
		</a>
		<div class="grow">
			<a class="title" href={ templ.SafeURL(fmt.Sprintf("/series/%d", r.Series.ID)) }>{ r.Series.Title }</a>
			<div class="muted">
				<a class="site" href={ templ.SafeURL(SiteURL(r.Site(), "/settings")) }>{ r.Series.ModuleName }</a>
				{ r.Detail() }
			</div>
		</div>
		<span class={ "badge", kind }>{ label }</span>
		if r.Actionable() {
			<form hx-post={ fmt.Sprintf("/series/%d/download", r.Series.ID) } hx-swap="none">
				<button type="submit">{ "Download " + Count(r.Waiting(), "chapter", "chapters") }</button>
			</form>
		}
	</li>
}
