package ui

import "fmt"

// Layout is the page chrome. The SSE connection lives here so that every page
// receives chapter progress without opening a stream of its own.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — atsume</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/live.js"></script>
			<script src="/static/htmx-sse.js"></script>
			<script src="/static/menu.js" defer></script>
		</head>
		<body hx-ext="sse" sse-connect="/events">
			<header>
				<div class="bar">
					<a href="/" class="brand">集め<span>atsume</span></a>
					<nav>
						<a href="/">Library</a>
						<a href="/modules">Sites</a>
					</nav>
				</div>
			</header>
			<main>
				<div class="bar">
					{ children... }
				</div>
			</main>
			<footer>
				<div class="bar">
					<!-- Fetches its own state on load so a page opened mid-download is
					     correct immediately, then follows the stream. -->
					<span
						id="queue-status"
						class="queue"
						hx-get="/queue"
						hx-trigger="load"
						hx-swap="outerHTML"
						sse-swap="queue"
					></span>
				</div>
			</footer>
		</body>
	</html>
}

// Sites is the chooser. Several hundred entries is too many to present as one
// flat list, so they are grouped by the category each module declares.
templ Sites(v SitesView) {
	@Layout("Sites") {
		<div class="head">
			<h1>Sites</h1>
		</div>
		<p class="muted">
			{ fmt.Sprintf("%d sites, from the FMD2 module catalogue at %s.", v.Total, v.Ref) }
			atsume does not vouch for them — some have moved or closed since the
			module for them was written.
		</p>
		<form class="search" hx-get="/modules" hx-target="#site-list" hx-trigger="input changed delay:200ms, search">
			<input
				type="search"
				name="q"
				value={ v.Query }
				placeholder="Search sites by name or category…"
				autocomplete="off"
			/>
		</form>
		<div id="site-list">
			@SiteGroups(v)
		</div>
	}
}

// SiteGroups is the swappable part, so a search does not reload the page.
templ SiteGroups(v SitesView) {
	if v.Found == 0 {
		<div class="empty">
			<strong>No sites match</strong>
			Nothing in the catalogue matches “{ v.Query }”.
		</div>
	}
	for _, g := range v.Groups {
		if g.Category != "" {
			<h2 class="category">
				{ g.Category }
				<span class="muted">{ fmt.Sprintf("%d", len(g.Entries)) }</span>
			</h2>
		}
		<ul class="grid">
			for _, e := range g.Entries {
				<li>
					if e.Available() {
						<a href={ templ.SafeURL(SiteURL(e.Site)) }>{ e.Site }</a>
					} else {
						<a class="broken" href={ templ.SafeURL(SiteURL(e.Site)) } title={ e.Err }>
							{ e.Site }
						</a>
						<span class="muted">unavailable</span>
					}
					if e.HasMirrors() {
						<span class="muted mirrors" title="This site is reachable at several addresses">
							{ Count(len(e.Mirrors), "address", "addresses") }
						</span>
					}
				</li>
			}
		</ul>
	}
}
