package ui

// Layout is the page chrome. The SSE connection lives here so that every page
// receives chapter progress without opening a stream of its own.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — atsume</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/live.js"></script>
			<script src="/static/htmx-sse.js"></script>
			<script src="/static/menu.js" defer></script>
		</head>
		<body hx-ext="sse" sse-connect="/events">
			<header>
				<div class="bar">
					<a href="/" class="brand">集め<span>atsume</span></a>
					<nav>
						<a href="/">Library</a>
						<a href="/modules">Sites</a>
					</nav>
				</div>
			</header>
			<main>
				<div class="bar">
					{ children... }
				</div>
			</main>
			<footer>
				<div class="bar">
					<!-- Fetches its own state on load so a page opened mid-download is
					     correct immediately, then follows the stream. Updates replace
					     what is inside, never the element, which would miss an update
					     sent before htmx listens on its replacement. -->
					<span
						id="queue-status"
						class="queue"
						hx-get="/queue"
						hx-trigger="load"
						hx-swap="innerHTML"
						sse-swap="queue"
					></span>
				</div>
			</footer>
		</body>
	</html>
}
