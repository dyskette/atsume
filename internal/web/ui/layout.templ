package ui

import "github.com/dyskette/atsume/internal/scraper"

// Layout is the page chrome. The SSE connection lives here so that every page
// receives chapter progress without opening a stream of its own.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — atsume</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-sse.js"></script>
		</head>
		<body hx-ext="sse" sse-connect="/events">
			<header>
				<div class="bar">
					<a href="/" class="brand">集め<span>atsume</span></a>
					<nav>
						<a href="/">Library</a>
						<a href="/modules">Sites</a>
					</nav>
				</div>
			</header>
			<main>
				<div class="bar">
					{ children... }
				</div>
			</main>
			<footer>
				<div class="bar">
					<span class="muted">Chapters land in your library directory.</span>
					<span id="queue-status" sse-swap="queue">idle</span>
				</div>
			</footer>
		</body>
	</html>
}

// ModuleList shows the sites available in the current module revision.
templ ModuleList(mods []scraper.ModuleInfo, ref string, query string) {
	@Layout("Sites") {
		<h1>Sites</h1>
		<p class="muted">{ len(mods) } modules at revision { ref }</p>
		<form class="search" hx-get="/modules" hx-target="#module-list" hx-trigger="input changed delay:200ms, search">
			<input
				type="search"
				name="q"
				value={ query }
				placeholder="Filter sites…"
				autocomplete="off"
			/>
		</form>
		<ul id="module-list" class="grid">
			@ModuleItems(mods)
		</ul>
	}
}

// ModuleItems is the swappable part of the site list.
templ ModuleItems(mods []scraper.ModuleInfo) {
	for _, m := range mods {
		<li>
			<a href={ templ.SafeURL("/modules/" + m.Name) }>{ m.Name }</a>
		</li>
	}
}
