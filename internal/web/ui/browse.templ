package ui

import (
	"fmt"
	"time"

	"github.com/dyskette/atsume/internal/store"
)

// BrowseView is a site's catalogue as the page shows it.
//
// The list is read once and kept. It used to be fetched on every visit and
// thrown away: MangaToon's module pages the site internally and takes three
// minutes to hand back 2,677 titles, so looking twice cost six minutes of
// someone else's bandwidth and a reader who could not leave the page.
type BrowseView struct {
	Module string
	// Catalogue is what is stored, including when it was read. Whether a
	// cached list is current is the one question it has to answer.
	Catalogue store.SiteCatalogue
	// Indexing is true while a read is running, which is when the page has
	// something to say other than what it holds.
	Indexing bool

	Titles []store.SiteTitle
	// Found is how many match the query, which is not how many are shown.
	Found  int
	Query  string
	Offset int
	Limit  int

	// Tracked maps a title's URL to the series already following it.
	Tracked map[string]int64
}

// ListURL is where the rows for the current query are fetched from.
func (v BrowseView) ListURL() string {
	return SiteURL(v.Module, fmt.Sprintf("/list?q=%s&offset=%d", queryEscape(v.Query), v.Offset))
}

// MoreURL fetches the next run of rows to append to what is on screen.
func (v BrowseView) MoreURL() string {
	return SiteURL(v.Module, fmt.Sprintf("/list?q=%s&offset=%d&rows=1",
		queryEscape(v.Query), v.Offset+v.Limit))
}

// More reports whether anything is left beyond the rows on screen.
func (v BrowseView) More() bool { return v.Offset+len(v.Titles) < v.Found }

// Empty reports that there is no catalogue at all yet, which is a different
// thing from a catalogue with nothing in it.
func (v BrowseView) Empty() bool { return !v.Catalogue.Exists && !v.Indexing }

// staleAfter is when a downloaded catalogue is old enough to say so plainly
// rather than leave the reader to work it out from a month and a year.
const staleAfter = 180 * 24 * time.Hour

// Source names where the list came from and how old its titles are.
func (v BrowseView) Source() string {
	out := " · from FMD2's published catalogue"
	if !v.Catalogue.DataAt.IsZero() {
		out += ", newest entry " + v.Catalogue.DataAt.Format("January 2006")
	}
	return out
}

// StaleSnapshot reports whether a downloaded catalogue is old enough that a
// reader should be told outright.
func (v BrowseView) StaleSnapshot() bool {
	if v.Catalogue.FromSite() || v.Catalogue.Age().IsZero() {
		return false
	}
	return time.Since(v.Catalogue.Age()) > staleAfter
}

// Browse is a site's page. The catalogue it holds renders at once; a read in
// progress reports itself as it goes.
templ Browse(v BrowseView) {
	@Layout(v.Module) {
		<div class="head">
			<h1>{ v.Module }</h1>
			<a href={ templ.SafeURL(SiteURL(v.Module, "/settings")) }>Site settings</a>
		</div>
		<p class="muted">
			Following a title downloads new chapters from then on, not the back
			catalogue.
		</p>
		<div id="catalogue-status" sse-swap={ "site-" + v.Module } hx-swap="innerHTML">
			@CatalogueStatus(v)
		</div>
		<form
			class="filter"
			hx-get={ SiteURL(v.Module, "/list") }
			hx-target="#site-index"
			hx-swap="innerHTML"
			hx-trigger="submit, input from:find input delay:250ms"
		>
			<input
				type="search"
				name="q"
				value={ v.Query }
				placeholder="Search this site's catalogue…"
				autocomplete="off"
			/>
		</form>
		<!-- The batch form lives outside the list so appended rows can join it
		     by id; a form element cannot wrap list items that arrive later. -->
		<form
			id="follow-many"
			class="batch"
			hx-post={ SiteURL(v.Module, "/follow") }
			hx-swap="none"
		>
			<button type="submit">Follow selected</button>
			<span class="muted">Tick several titles to follow them in one go.</span>
		</form>
		<div id="site-index">
			@BrowseList(v)
		</div>
		<script src="/static/site-filter.js"></script>
	}
}

// CatalogueStatus says where the list came from and when, and offers the one
// action that changes the answer.
//
// A date on its own is trivia. Next to a way to act on it, it is a decision:
// this is five months old, do I care. FMD2 has never told anyone how old its
// prebuilt databases are, and people have been asking since 2021.
templ CatalogueStatus(v BrowseView) {
	<p class={ "catalogue", templ.KV("working", v.Indexing) }>
		switch {
			case v.Indexing:
				<span class="dot working"></span>
				if v.Catalogue.Note != "" {
					{ v.Catalogue.Note }
				} else if v.Catalogue.Titles > 0 {
					<!-- Counted from what is already stored, so a reader who
					     reloads mid-read sees progress rather than the same
					     sentence they left. -->
					{ fmt.Sprintf("Reading %s's catalogue — %s so far. You can leave this page; it carries on.",
						v.Module, Count(v.Catalogue.Titles, "title", "titles")) }
				} else {
					{ fmt.Sprintf("Reading %s's catalogue. You can leave this page; it carries on.", v.Module) }
				}
			case !v.Catalogue.Exists:
				{ fmt.Sprintf("%s has not been read yet.", v.Module) }
				<form hx-post={ SiteURL(v.Module, "/index") } hx-swap="none">
					<button type="submit" class="primary">Read the catalogue</button>
				</form>
			default:
				{ Count(v.Catalogue.Titles, "title", "titles") }
				if v.Catalogue.FromSite() {
					{ " · read from the site " + ago(v.Catalogue.BuiltAt) }
				} else {
					<!-- Where it came from and how old the titles are, which
					     for a downloaded list is not when it was downloaded.
					     A snapshot can be years older than the file holding
					     it, and a reader deciding whether to spend four
					     minutes reading the site needs the first number, not
					     the second. -->
					<!-- One expression, because templ puts a space between two
					     and "catalogue , newest entry" is not a sentence. -->
					{ v.Source() }
					if v.StaleSnapshot() {
						<span class="badge failed">{ olderThan(v.Catalogue.Age()) }</span>
					}
				}
				if !v.Catalogue.Complete {
					<span class="badge failed" title={ v.Catalogue.Note }>partial</span>
				}
				<button
					type="button"
					class="link"
					hx-get={ SiteURL(v.Module, "/reread") }
					hx-target="#catalogue-status"
					hx-swap="innerHTML"
				>
					if v.Catalogue.FromSite() {
						Read again
					} else {
						Read the site for a current list
					}
				</button>
		}
	</p>
}

// BrowseList is the catalogue itself.
templ BrowseList(v BrowseView) {
	if v.Found == 0 && v.Indexing {
		<div class="empty">
			<strong>Nothing yet</strong>
			Titles appear here as they are read. Nothing is lost if you leave.
		</div>
	} else if v.Empty() {
		<div class="empty">
			<strong>Nothing read yet</strong>
			<p>
				atsume has not read this site's list of titles. Reading it takes
				as long as the site takes to answer — a few seconds for most, a
				few minutes for the largest — and then it is kept, so this is a
				one-off rather than a wait on every visit.
			</p>
		</div>
	} else if v.Found == 0 && v.Query != "" {
		<div class="empty">
			<strong>No match</strong>
			{ fmt.Sprintf("Nothing in the %s read from this site matches that.", Count(v.Catalogue.Titles, "title", "titles")) }
		</div>
	} else if v.Found == 0 {
		<div class="empty">
			<strong>Nothing listed</strong>
			The read finished and the site listed no titles.
		</div>
	} else if v.Query != "" {
		<p class="muted">{ fmt.Sprintf("%s match.", Count(v.Found, "title", "titles")) }</p>
	}
	<ul class="rows" id="site-rows">
		@BrowseRows(v)
	</ul>
	if v.Indexing {
		<!-- While a read runs the list catches up with it, so the wait is
		     until the first titles arrive rather than until the read proves
		     it has finished. It disarms itself: the reply that comes back
		     after the read ends carries no trigger. -->
		<div
			hx-get={ v.ListURL() }
			hx-trigger="load delay:5s"
			hx-target="#site-index"
			hx-swap="innerHTML"
		></div>
	}
}

// BrowseRows is the appendable part: the titles plus the control that fetches
// the ones after them.
templ BrowseRows(v BrowseView) {
	for i, t := range v.Titles {
		@BrowseRow(v, v.Offset+i, t)
	}
	if v.More() {
		<li class="more">
			<button
				type="button"
				hx-get={ v.MoreURL() }
				hx-target="closest li"
				hx-swap="outerHTML"
			>Load more</button>
		</li>
	}
}

// BrowseRow is one title. The title is the link, because in a catalogue you
// open the thing by clicking the thing; a separate "Preview" beside "Follow"
// presented navigation and commitment as siblings.
templ BrowseRow(v BrowseView, i int, t store.SiteTitle) {
	{{ key := fmt.Sprintf("%d", i) }}
	{{ label := titleLabel(t) }}
	<li class="site-row" data-title={ label }>
		if _, ok := v.Tracked[t.URL]; !ok {
			<input class="pick" type="checkbox" name="sel" value={ key } form="follow-many" aria-label={ "Select " + label }/>
			<input type="hidden" name={ "u" + key } value={ t.URL } form="follow-many"/>
			<input type="hidden" name={ "t" + key } value={ label } form="follow-many"/>
		} else {
			<span class="pick"></span>
		}
		<a class="title" href={ templ.SafeURL(previewURL(v.Module, t.URL)) }>{ label }</a>
		if id, ok := v.Tracked[t.URL]; ok {
			<span class="badge done">following</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/series/%d", id)) }>Open</a>
		} else {
			<form hx-post="/series" hx-swap="outerHTML" hx-target="closest li">
				<input type="hidden" name="module" value={ v.Module }/>
				<input type="hidden" name="url" value={ t.URL }/>
				<input type="hidden" name="name" value={ label }/>
				<input type="hidden" name="context" value="row"/>
				<button type="submit">Follow</button>
			</form>
		}
	</li>
}

// Followed replaces a catalogue row once the series has been followed. It
// stays where it was: the reader is mid-scan of a list, and following one
// title is no reason to move them.
templ Followed(name string, id int64) {
	<li class="site-row followed" data-title={ name }>
		<span class="pick"></span>
		<a class="title" href={ templ.SafeURL(fmt.Sprintf("/series/%d", id)) }>{ name }</a>
		<span class="badge done">following</span>
		<a href={ templ.SafeURL(fmt.Sprintf("/series/%d", id)) }>Open</a>
	</li>
}

// ConfirmReread says what reading a site again will cost before it is done.
//
// On a large site this is minutes of someone else's bandwidth, and a button
// that starts it with no warning is one a reader is right to be afraid of.
templ ConfirmReread(v BrowseView) {
	<div class="confirm">
		<p><strong>{ fmt.Sprintf("Read %s's catalogue again?", v.Module) }</strong></p>
		<p class="muted">
			atsume asks the site for its whole list of titles, one request a
			second.
			if v.Catalogue.FromSite() && v.Catalogue.Note != "" {
				{ " Last time: " + v.Catalogue.Note + "." }
			} else if !v.Catalogue.FromSite() {
				{ " What is here now was downloaded rather than read, so this is the first time the site itself is asked." }
			}
			{ fmt.Sprintf(" The %s already here stay usable while it runs, and are replaced only when it finishes.",
				Count(v.Catalogue.Titles, "title", "titles")) }
		</p>
		<div class="actions">
			<form hx-post={ SiteURL(v.Module, "/index") } hx-target="#catalogue-status" hx-swap="innerHTML">
				<button type="submit" class="primary">Read it again</button>
			</form>
			<button
				type="button"
				hx-get={ SiteURL(v.Module, "/status") }
				hx-target="#catalogue-status"
				hx-swap="innerHTML"
			>Cancel</button>
		</div>
	</div>
}
