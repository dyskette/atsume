/bin/
*_templ.go

# Upstream FMD2 website modules are GPL-2.0-only, which is incompatible with
# this project's GPL-3.0 licence. They are fetched at runtime and, for tests,
# into these ignored paths. Never commit a module file or anything derived from
# one — see docs/MODULES.md.
testdata/fmd2/
testdata/corpus.json

# Recorded traffic is a site's own content, and so is anything derived from it.
# Capture locally with ATSUME_RECORD=1; see internal/scraper/recorded_test.go.
internal/scraper/testdata/recorded/*/cassette/
internal/scraper/testdata/recorded/*/golden.json
